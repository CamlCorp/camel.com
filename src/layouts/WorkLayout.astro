---
import { Image } from "astro:assets";
const { frontmatter } = Astro.props;
import BaseLayout from "./BaseLayout.astro";
---

<style>
  .container {
    /* padding-top: var(--m-1); */
  }
  .frontMatter {
    /* position: sticky; */
    display: block;
    top: var(--m-1);
    z-index: 1;
    padding-left: var(--m-1);
    padding-right: var(--m-1);
    /* padding-bottom: var(--m-3); */
    /* max-width: calc(var(--maxWidth)); */
  }
  .meta {
    max-width: 75ch;
    margin-right: var(--m-1);
    white-space: pre-line;
  }
  .meta p {
    font-weight: normal;
  }
  .frontMatter a {
    text-decoration: none;
  }
  .frontMatter a:hover {
    text-decoration: underline;
  }
  .backLink {
    /* background-color: red; */
    /* display: none; */
  }

  .back-button {
    background: var(--bgColor);
    border: none;
    font-family: var(--mainFont);
    padding: 0;
    font-size: 16px;
    color: var(--txtColor);
    cursor: pointer;
    text-decoration: none;
  }

  .back-button:hover {
    text-decoration: underline;
  }
  @media (max-width: 1511px) {
    .frontMatter {
      /* position: relative;
      top: 0; */
    }
    .meta {
      width: 100%;
    }
  }
  .link-container {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--m-2);
    align-items: flex-start; /* Prevent stretching to container width */
  }

  a {
    display: inline-block; /* Ensures the anchor size matches its content */
    text-decoration: underline;
    padding: 0; /* Remove any unnecessary padding */
    margin: 0; /* Remove unnecessary margins */
  }

  :global(.footnotes ol li p a) {
    word-break: break-all;
  }

  img {
    width: 100%;
    height: auto;
    margin-bottom: var(--m-2);
    z-index: 1;
  }
  @media (max-width: 1172px) {
    img {
      /* margin-top: var(--m-1); */
    }
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin-bottom: var(--m-2);
  }
  li {
    margin-right: 4px;
  }
  p {
    font-weight: bold;
  }
  .mdContainer {
    display: flex;
    align-items: center;
    flex-direction: column;
    /* margin-bottom: var(--m-1); */
  }
  @media (max-width: 1172px) {
    .mdContainer {
      margin: var(--m-1);
      margin-top: 0;
    }
    .mdContainer img:first-child {
      display: none;
    }
  }
  .md {
    display: flex;
    flex-direction: column;
    max-width: var(--maxWidth);
    z-index: 1;
  }
  .btnContainer {
    margin: var(--m-2) 0;
    display: flex;
    flex-direction: row;
    gap: var(--m-3);
    width: 100%;
    justify-content: center;
  }
  .btnContainer a {
    text-decoration: none;
  }
  .btnContainer a:hover {
    text-decoration: underline;
  }
  button {
    background-color: white;
    border: none;
    font-family: var(--mainFont);
    padding: 0;
    font-size: 16px;
    color: black;
  }
  a:hover {
    cursor: pointer;
    text-decoration: underline;
  }

  /* @media (max-width: 1172px) {
    .imgGrid {
      display: none;
    }
  } */

  /* Image Grid Styles */
  .imgGrid {
    /* margin: var(--m-2); */
    /* margin-right: var(--m-1); */
    margin-top: var(--m-1);
    margin-left: var(--m-1);
    /* margin-right: var(--m-1); */
  }
  @media (max-width: 1172px) {
    .imgGrid {
      margin-left: 0;
    }
  }

  .imageGrid {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
    margin-bottom: var(--m-1);
    justify-items: flex-start;
  }

  /* Mobile/Responsive Image Grid */
  @media (max-width: 1172px) {
    .imageGrid {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: thin;
      -webkit-overflow-scrolling: touch;
      /* padding: var(--m-1) 0; */
    }
  }

  /* Lightbox overlay */
  .lightbox {
    padding-top: var(--m-0);
    position: fixed;
    inset: 0;
    /* background: rgba(65, 51, 14, 0.9); */
    background-color: white;
    display: none;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    z-index: 9999;
    /* padding-top: var(--m-1); */
    /* padding: var(--m-2); */
  }
  .lightbox img {
    max-width: 90vw;
    max-height: 80vh;
    width: 100%;
    height: auto;
    object-fit: contain;
    border: none;
    outline: none;
    /* margin-bottom: var(--m-1); */
    /* box-shadow: 0 10px 30px rgba(65, 51, 14, 0.4); */
    cursor: pointer;
  }
  .lightbox button {
    position: absolute;
    background: none;
    border: none;
    color: var(--txtColor);
    font-size: 16px;
    cursor: pointer;
    line-height: 1;
  }
  .lightbox button:hover {
    text-decoration: underline;
  }

  .lightbox .lb-prev {
    left: var(--m-1);
  }
  @media (max-width: 1172px) {
    .lightbox .lb-prev {
      bottom: var(--m-2);
    }
    .lightbox .lb-next {
      bottom: var(--m-2);
    }
    .lightbox .lb-caption {
      font-size: 14px;
    }
  }
  .lightbox .lb-next {
    right: var(--m-1);
  }
  .lightbox .lb-close {
    top: var(--m-2);
    right: var(--m-1);
    font-size: 15px;
    color: var(--txtColor);
  }
  .lightbox .lb-caption {
    padding: var(--m-2);
    font-size: 15px;
    text-align: center;
  }
  .lightbox .lb-counter {
    position: absolute;
    top: var(--m-2);
    left: var(--m-1);
    font-size: 15px;
    color: var(--txtColor);
  }

  /* Navigation buttons for image grid */
  .nav-buttons {
    display: flex;
    gap: 4px;
    z-index: 10;
    justify-content: flex-start;
    margin: var(--m-1);
  }
  @media (max-width: 1172px) {
    .nav-buttons {
      display: none;
    }
  }

  .nav-button {
    background: var(--bgColor);
    border: none;
    font-family: var(--mainFont);
    font-size: 16px;
    color: var(--txtColor);
    cursor: pointer;
    text-decoration: none;
    user-select: none;
  }

  .nav-button:hover {
    text-decoration: underline;
  }

  .nav-button:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .nav-button:disabled:hover {
    text-decoration: none;
  }

  .imgGrid {
    position: relative;
  }
</style>

<BaseLayout
  title={frontmatter.description}
  description={frontmatter.meta}
  image={frontmatter.image.src}
/>
<div class="container">
  <div class="frontMatter">
    <ul>
      {
        frontmatter.tags.map((tag: any, index: number) => (
          <li>
            <a href={`/index/${tag}`}>[{tag}]</a>
          </li>
        ))
      }
      <!-- <li>{new Date(frontmatter.pubDate).getFullYear()}</li> -->
    </ul>
    <p>{frontmatter.description}</p>
    <div class="meta">
      {
        frontmatter.meta
          .split("<br>")
          .map((section: string) => <p>{section}</p>)
      }
    </div>
    <p></p>
    <div
      class="link-container"
      style={`display: ${frontmatter.links?.length ? "flex" : "none"}`}
    >
      {
        frontmatter.links.map((link: any, index: number) => (
          <a href={link} target="_blank" rel="noopener noreferrer">
            {new URL(link).hostname}
          </a>
        ))
      }
    </div>
    <!-- <div class="backLink">
      <a href="/work" class="back-button">[back]</a>
    </div> -->
    <!-- Lightbox overlay -->
    <div id="lightbox" class="lightbox" aria-hidden="true">
      <div id="lbCounter" class="lb-counter"></div>
      <button id="lbClose" class="lb-close" aria-label="Close">[close]</button>
      <button id="lbPrev" class="lb-prev" aria-label="Previous">[prev]</button>
      <img id="lightboxImage" alt="" />
      <button id="lbNext" class="lb-next" aria-label="Next">[next]</button>
      <div id="lightboxCaption" class="lb-caption"></div>
    </div>
  </div>
  <div class="nav-buttons">
    <button class="nav-button" id="scrollLeft" aria-label="Scroll left"
      >[←]</button
    >
    <button class="nav-button" id="scrollRight" aria-label="Scroll right"
      >[→]</button
    >
  </div>
  <div class="imgGrid" id="imageGallery">
    <div class="imageGrid" id="imageGrid"></div>
  </div>
  <div class="mdContainer">
    <Image src={frontmatter.image} alt={frontmatter.imgAlt} />

    <article class="md">
      <slot />
      <hr />
      <div class="btnContainer">
        <a class="backBtn" href="/work">[back]</a>
        <a class="back-to-top" id="backToTop">[top]</a>
      </div>
    </article>
  </div>
  <!-- Back to Top Button -->
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Back to Top Button functionality
    const backToTopBtn = document.getElementById("backToTop");

    if (backToTopBtn) {
      window.addEventListener("scroll", () => {
        // Show button when scrolled down
        if (window.scrollY > 300) {
          backToTopBtn.style.display = "block";
        } else {
          backToTopBtn.style.display = "none";
        }
      });

      backToTopBtn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "auto" });
      });
    }
    // Select all anchor tags
    const anchorTags = document.querySelectorAll(".md a:not(.backBtn)");

    anchorTags.forEach((anchor) => {
      const href = anchor.getAttribute("href");

      // Skip anchor links (e.g., href="#some-id")
      if (href && !href.startsWith("#")) {
        anchor.setAttribute("target", "_blank");
        anchor.setAttribute("rel", "noopener noreferrer");
      }
    });

      // Gather all images displayed in the WorkLayout + lightbox wiring
      const imageGrid = document.getElementById("imageGrid");
      if (imageGrid) {
        const gallerySrcs: string[] = [];
        const galleryAlts: string[] = [];
        const galleryTypes: string[] = []; // Track whether each item is 'img' or 'iframe'
        let currentIndex = 0;

      const lightbox = document.getElementById(
        "lightbox"
      ) as HTMLDivElement | null;
      const lightboxImage = document.getElementById(
        "lightboxImage"
      ) as HTMLImageElement | null;
      const lightboxCaption = document.getElementById(
        "lightboxCaption"
      ) as HTMLDivElement | null;
      const lbPrev = document.getElementById(
        "lbPrev"
      ) as HTMLButtonElement | null;
      const lbNext = document.getElementById(
        "lbNext"
      ) as HTMLButtonElement | null;
      const lbClose = document.getElementById(
        "lbClose"
      ) as HTMLButtonElement | null;

      function formatCaption(text: string) {
        if (!text) return "";
        let html = String(text);

        // Make quoted text italic (text surrounded by quotes) - handle both single and double quotes
        html = html.replace(/"([^"]+)"/g, "<em>$1</em>");
        html = html.replace(/'([^']+)'/g, "<em>$1</em>");

        // Markdown-style links: [label](https://example.com)
        html = html.replace(
          /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
          '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>'
        );
        // Raw URLs
        html = html.replace(
          /(https?:\/\/[^\s<>'")]+)/g,
          '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>'
        );
        return html;
      }

      const lbCounter = document.getElementById("lbCounter");

      function showLightbox(index: number) {
        if (!lightbox || !lightboxImage || gallerySrcs.length === 0) return;
        currentIndex = (index + gallerySrcs.length) % gallerySrcs.length;
        
        // Check if the current item is an iframe using our tracking array
        const isIframe = galleryTypes[currentIndex] === "iframe";
        
        if (isIframe) {
          // Hide the image and show iframe
          lightboxImage.style.display = "none";
          let lightboxIframe = document.getElementById("lightboxIframe") as HTMLIFrameElement;
          if (!lightboxIframe) {
            lightboxIframe = document.createElement("iframe");
            lightboxIframe.id = "lightboxIframe";
            lightboxIframe.style.maxWidth = "90vw";
            lightboxIframe.style.maxHeight = "80vh";
            lightboxIframe.style.width = "100%";
            lightboxIframe.style.height = "80vh";
            lightboxIframe.style.border = "none";
            lightboxIframe.style.outline = "none";
            lightboxIframe.style.cursor = "pointer";
            lightbox.insertBefore(lightboxIframe, lightboxImage.nextSibling);
          }
          lightboxIframe.src = gallerySrcs[currentIndex];
          lightboxIframe.style.display = "block";
        } else {
          // Show the image and hide iframe
          lightboxImage.style.display = "block";
          const lightboxIframe = document.getElementById("lightboxIframe") as HTMLIFrameElement;
          if (lightboxIframe) {
            lightboxIframe.style.display = "none";
            lightboxIframe.src = ""; // Clear iframe src when not in use
          }
          lightboxImage.src = gallerySrcs[currentIndex];
        }
        
        if (lightboxCaption) {
          const altText = galleryAlts[currentIndex] || "";
          lightboxCaption.innerHTML = formatCaption(altText);
        }

        // Update counter (1-based index)
        if (lbCounter) {
          lbCounter.textContent = `${currentIndex + 1} / ${gallerySrcs.length}`;
        }
        lightbox.style.display = "flex";
        document.body.style.overflow = "hidden";
      }
      function hideLightbox() {
        if (!lightbox) return;
        lightbox.style.display = "none";
        document.body.style.overflow = "";
      }
      lbPrev?.addEventListener("click", () => showLightbox(currentIndex - 1));
      lbNext?.addEventListener("click", () => showLightbox(currentIndex + 1));
      lbClose?.addEventListener("click", hideLightbox);
      lightbox?.addEventListener("click", (e) => {
        if (e.target === lightbox) hideLightbox();
      });
      lightboxImage?.addEventListener("click", () =>
        showLightbox(currentIndex + 1)
      );
      document.addEventListener("keydown", (e) => {
        if (!lightbox || lightbox.style.display !== "flex") return;
        if (e.key === "Escape") hideLightbox();
        if (e.key === "ArrowRight") showLightbox(currentIndex + 1);
        if (e.key === "ArrowLeft") showLightbox(currentIndex - 1);
      });

      // Add the frontmatter image as the first image in the grid
      const frontmatterImage = document.querySelector(".mdContainer img");
      if (frontmatterImage) {
        const frontmatterImgClone = frontmatterImage.cloneNode(true) as HTMLImageElement;
        // Set constant height, let width be proportional
        frontmatterImgClone.style.height = "144px";
        frontmatterImgClone.style.width = "auto";
        frontmatterImgClone.style.objectFit = "contain";
        frontmatterImgClone.style.objectPosition = "center";
        frontmatterImgClone.style.display = "block";
        frontmatterImgClone.style.outline = "0.25px solid black";
        frontmatterImgClone.style.borderTop = "0.25px solid black";
        frontmatterImgClone.style.borderBottom = "0.25px solid black";
        frontmatterImgClone.style.borderLeft = "0.25px solid black";

        imageGrid.appendChild(frontmatterImgClone);
        const thisIndex = gallerySrcs.length;
        const orig = frontmatterImage as HTMLImageElement;
        gallerySrcs.push(orig.src);
        galleryAlts.push(orig.alt || "");
        galleryTypes.push("img");
        frontmatterImgClone.style.cursor = "zoom-in";
        frontmatterImgClone.addEventListener("click", () => showLightbox(thisIndex));
        console.log("Added frontmatter image with src:", frontmatterImgClone.src);
      }

      // Get all images and iframes from the article content in document order
      const allContent = document.querySelectorAll(".md img, .md iframe");
      console.log("Found", allContent.length, "total media items in content");

      // Process all content in document order
      allContent.forEach((element, index) => {
        const isIframe = element.tagName === "IFRAME";
        
        if (isIframe) {
          const iframe = element as HTMLIFrameElement;
          const iframeClone = iframe.cloneNode(true) as HTMLIFrameElement;
          // Set constant height, let width be proportional
          iframeClone.style.height = "144px";
          iframeClone.style.width = "auto";
          iframeClone.style.display = "block";
          iframeClone.style.border = "0.25px solid black";

          imageGrid.appendChild(iframeClone);
          const thisIndex = gallerySrcs.length;
          gallerySrcs.push(iframe.src);
          galleryAlts.push(iframe.title || "Embedded content");
          galleryTypes.push("iframe");
          iframeClone.style.cursor = "zoom-in";
          iframeClone.addEventListener("click", () => showLightbox(thisIndex));
          console.log("Added iframe", index + 1, "with src:", iframeClone.src);
        } else {
          const img = element as HTMLImageElement;
          const imgClone = img.cloneNode(true) as HTMLImageElement;
          // Set constant height, let width be proportional
          imgClone.style.height = "144px";
          imgClone.style.width = "auto";
          imgClone.style.objectFit = "contain";
          imgClone.style.objectPosition = "center";
          imgClone.style.display = "block";

          // Only apply border styling to the first image
          if (index === 0) {
            imgClone.style.outline = "0.25px solid black";
            imgClone.style.borderTop = "0.25px solid black";
            imgClone.style.borderBottom = "0.25px solid black";
            imgClone.style.borderLeft = "0.25px solid black";
          } else {
            imgClone.style.outline = "0.25px solid black";
            imgClone.style.borderTop = "0.25px solid black";
            imgClone.style.borderBottom = "0.25px solid black";
          }

          imageGrid.appendChild(imgClone);
          const thisIndex = gallerySrcs.length;
          gallerySrcs.push(img.src);
          galleryAlts.push(img.alt || "");
          galleryTypes.push("img");
          imgClone.style.cursor = "zoom-in";
          imgClone.addEventListener("click", () => showLightbox(thisIndex));
          console.log("Added image", index + 1, "with src:", imgClone.src);
        }
      });

      // Hide the gallery if no images were found
      if (imageGrid.children.length === 0) {
        const gallery = document.getElementById("imageGallery");
        if (gallery) {
          gallery.style.display = "none";
        }
      }

      console.log("Total images in gallery:", imageGrid.children.length);

      // Add scroll navigation functionality
      const scrollLeftBtn = document.getElementById(
        "scrollLeft"
      ) as HTMLButtonElement;
      const scrollRightBtn = document.getElementById(
        "scrollRight"
      ) as HTMLButtonElement;

      function updateButtonStates() {
        if (!imageGrid || !scrollLeftBtn || !scrollRightBtn) return;

        const isAtStart = imageGrid.scrollLeft <= 0;
        const isAtEnd =
          imageGrid.scrollLeft >= imageGrid.scrollWidth - imageGrid.clientWidth;
        const isScrollable = imageGrid.scrollWidth > imageGrid.clientWidth;

        scrollLeftBtn.disabled = isAtStart;
        scrollRightBtn.disabled = isAtEnd;

        // Hide nav buttons if not scrollable or both disabled
        const navButtons = document.querySelector(
          ".nav-buttons"
        ) as HTMLElement;
        if (navButtons) {
          if (!isScrollable || (isAtStart && isAtEnd)) {
            navButtons.style.display = "none";
          } else {
            navButtons.style.display = "flex";
          }
        }
      }

      function scrollGrid(direction: "left" | "right") {
        if (!imageGrid) return;

        const scrollAmount = 200; // Adjust this value to control scroll distance
        const currentScroll = imageGrid.scrollLeft;
        const newScroll =
          direction === "left"
            ? currentScroll - scrollAmount
            : currentScroll + scrollAmount;

        imageGrid.scrollTo({
          left: newScroll,
          behavior: "smooth",
        });
      }

      if (scrollLeftBtn && scrollRightBtn) {
        scrollLeftBtn.addEventListener("click", () => scrollGrid("left"));
        scrollRightBtn.addEventListener("click", () => scrollGrid("right"));

        // Update button states on scroll
        imageGrid.addEventListener("scroll", updateButtonStates);

        // Initial button state update
        updateButtonStates();
      }
    }
  });
</script>
