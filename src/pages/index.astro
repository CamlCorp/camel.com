---
import GetWork from "../components/GetWork.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
const title = "";
const meta =
  "CAMEL is a design and research practice that embeds buildings, drawings, objects, and software with culture. CAMEL utilizes the archives of architecture and design to uncover lost and often forgotten cultural matters of importance. These findings are then used to inform proposals and speculations in the form of design-research projects. The ecological, material, and cultural realities of Earth inform the basis of our work. With ancestral roots in Afghanistan, CAMEL carries on the traditions of architecture, design, and wisdom found across the Islamic regions of Central Asia.";
import image from "../images/og.png";
import { getCollection } from "astro:content";
const allWork = await getCollection("work");

const latinStart = (str: string) => str.match(/[a-zA-Z].*/)?.[0] ?? str;
allWork.sort((a, b) => latinStart(a.data.title).localeCompare(latinStart(b.data.title)));
---

<style>
  ul {
    margin-left: var(--m-1);
    margin-right: var(--m-1);
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--m-4);
    margin-bottom: var(--m-1);
  }
  a {
    display: inline-block; /* Prevents full-width stretching */
    max-width: fit-content; /* Ensures it only takes up necessary space */
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  img {
    width: 72px;
    object-fit: cover;
    height: 72px;
    display: block;
  }
</style>

<BaseLayout title={title} description={meta} image={image.src}>
  <ul>
    {
      allWork.map((post: any) => (
        <li>
          <a href={`/work/${post.id}/`}>
            <Image src={post.data.image} alt={post.data.imgAlt} />
          </a>
          <GetWork post={post} />
        </li>
      ))
    }
  </ul>
</BaseLayout>
